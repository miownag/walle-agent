{
  "name": "walle-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Walle Agent SDK — micro-core + plugin architecture agent framework",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src/**/*.ts",
    "clean": "pnpm -r exec rm -rf dist",
    "stream": "pnpm --filter walle-agent-examples run stream",
    "basic": "pnpm --filter walle-agent-examples run basic",
    "memory": "pnpm --filter walle-agent-examples run memory",
    "evolution": "pnpm --filter walle-agent-examples run evolution",
    "mcp": "pnpm --filter walle-agent-examples run mcp",
    "rag": "pnpm --filter walle-agent-examples run rag",
    "trace": "pnpm --filter walle-agent-examples run trace",
    "complete": "pnpm --filter walle-agent-examples run complete"
  },
  "keywords": [
    "agent",
    "llm",
    "sdk",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "dotenv": "^17.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
