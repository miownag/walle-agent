{
  "name": "@walle-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Walle local-only coding Agent desktop application",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "build:sdk": "pnpm --dir ../.. --filter '@walle-agent/desktop^...' build",
    "dev": "pnpm run build:sdk && electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "build:standalone": "pnpm run build:sdk && pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:mac": "pnpm run build:standalone && electron-builder --mac"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-document": "^3.19.0",
    "@tiptap/extension-hard-break": "^3.19.0",
    "@tiptap/extension-paragraph": "^3.19.0",
    "@tiptap/extension-text": "^3.19.0",
    "@tiptap/extensions": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@walle-agent/anthropic": "workspace:*",
    "@walle-agent/core": "workspace:*",
    "@walle-agent/evolution": "workspace:*",
    "@walle-agent/mcp": "workspace:*",
    "@walle-agent/memory": "workspace:*",
    "@walle-agent/openai": "workspace:*",
    "@walle-agent/rag": "workspace:*",
    "@walle-agent/sandbox": "workspace:*",
    "@walle-agent/skills": "workspace:*",
    "@walle-agent/team": "workspace:*",
    "@walle-agent/trace": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.walle.desktop",
    "productName": "Walle",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  }
}
