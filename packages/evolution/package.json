{
  "name": "@walle-agent/evolution",
  "version": "0.1.0",
  "description": "Walle Agent SDK — self-evolution plugin (explicit remember / periodic review / task review, with human-in-the-loop proposal queue)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@walle-agent/core": "workspace:*",
    "@walle-agent/memory": "workspace:*",
    "@walle-agent/skills": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@walle-agent/skills": { "optional": true }
  },
  "devDependencies": {
    "@walle-agent/core": "workspace:*",
    "@walle-agent/memory": "workspace:*",
    "@walle-agent/skills": "workspace:*",
    "typescript": "^5.7.0",
    "tsup": "^8.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
