{
  "name": "@walle-agent/skills",
  "version": "0.1.0",
  "description": "Walle Agent SDK — skills plugin (reusable procedures, auto-injected into prompt via collect_context)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@walle-agent/core": "workspace:*"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@walle-agent/core": "workspace:*",
    "typescript": "^5.7.0",
    "tsup": "^8.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
